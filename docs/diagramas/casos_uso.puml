@startuml
!include style.iuml
left to right direction
skinparam packageStyle rectangle
actor "Invitado" as Inv
actor "Pasajero\n(ciudadano registrado)" as Pas
actor "Administrador" as Adm
actor "Firebase\n(Auth, Firestore, Storage)" as FB <<sistema>>
actor "GPS / Cámara\ndel dispositivo" as HW <<sistema>>
Pas -|> Inv
rectangle "Andén" {
  usecase "CU-01 Iniciar sesión" as UC1
  usecase "CU-02 Entrar como invitado" as UC2
  usecase "CU-03 Consultar mapa y\ncatálogo de estaciones" as UC3
  usecase "CU-04 Buscar y filtrar\n(accesibilidad, favoritos)" as UC4
  usecase "CU-05 Consultar ficha\nde estación" as UC5
  usecase "CU-06 Marcar estación\nfavorita" as UC6
  usecase "CU-07 Ubicar estación\nmás cercana" as UC7
  usecase "CU-08 Reportar incidencia" as UC8
  usecase "Validar geocerca\n(<= 300 m)" as UCg
  usecase "CU-09 Capturar evidencia\n(foto / video)" as UC9
  usecase "CU-10 Sincronizar reportes\npendientes" as UC10
  usecase "CU-11 Moderar reportes" as UC11
  usecase "CU-12 Moderar paradas\ncomunitarias" as UC12
}
Inv --> UC2
Inv --> UC3
Inv --> UC4
Inv --> UC5
Inv --> UC6
Inv --> UC7
Pas --> UC1
Pas --> UC8
Adm --> UC1
Adm --> UC11
Adm --> UC12
UC8 .> UCg : <<include>>
UC9 .> UC8 : <<extend>>
UC8 .> UC10 : <<include>>
UC7 --> HW
UCg --> HW
UC9 --> HW
UC1 --> FB
UC10 --> FB
@enduml
